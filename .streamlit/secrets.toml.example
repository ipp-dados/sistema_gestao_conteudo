# Sistema de Gestão de Conteúdo
# Modelo de configuração do ambiente
#
# Copie este arquivo para .streamlit/secrets.toml e substitua os valores fictícios.
# Nunca publique o secrets.toml no GitHub.
# No Streamlit Cloud, cole o mesmo conteúdo (sem a seção [dev]) em Settings > Secrets.

# --- Apenas depuração local: pula o login Google ----------------------------
# Remova esta seção para testar o login real. Nunca adicione no Streamlit Cloud.
# Obs.: com o bypass ativo não há token OAuth, então a integração com o Drive
# (st.user.tokens) não funciona; o app mostra um aviso e segue.
[dev]
bypass_login = true
email = "seu-email-autorizado@gmail.com"   # precisa estar em USUARIOS_AUTORIZADOS (app.py)

# --- Autenticação Streamlit (st.login) --------------------------------------
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"   # Cloud: https://<seu-app>.streamlit.app/oauth2callback
cookie_secret = "GERE: python -c \"import secrets;print(secrets.token_urlsafe(32))\""
expose_tokens = "access"

# --- Autenticação Google OAuth ----------------------------------------------
[auth.google]
client_id = "XXXXXXXX.apps.googleusercontent.com"
client_secret = "GOCSPX-XXXXXXXX"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
client_kwargs = { scope = "openid email profile https://www.googleapis.com/auth/drive.file" }

# --- Conta de serviço Google Sheets -----------------------------------------
# Valores vêm da chave JSON da conta de serviço. A planilha deve ser
# compartilhada com client_email (Editor).
# No ambiente local, o código também permite OAuth via credentials.json.
[gcp_service_account]
type = "service_account"
project_id = "seu-project-id"
private_key_id = "XXXXXXXX"
private_key = "-----BEGIN PRIVATE KEY-----\nXXXXXXXX\n-----END PRIVATE KEY-----\n"
client_email = "sua-conta@seu-project-id.iam.gserviceaccount.com"
client_id = "000000000000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/sua-conta%40seu-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
