# Copy to .streamlit/secrets.toml and fill in. NEVER commit secrets.toml.
# On Streamlit Cloud, paste the same content (minus [dev]) into Settings > Secrets.

# --- Local debugging only: skip Google login --------------------------------
# Remove this section to test the real login. Never add it on Streamlit Cloud.
[dev]
bypass_login = true
email = "your-authorized-email@gmail.com"   # must be in USUARIOS_AUTORIZADOS (app.py)

# --- Google login (st.login) -------------------------------------------------
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"   # Cloud: https://<your-app>.streamlit.app/oauth2callback
cookie_secret = "GENERATE: python -c \"import secrets;print(secrets.token_urlsafe(32))\""

[auth.google]
client_id = "XXXXXXXX.apps.googleusercontent.com"
client_secret = "GOCSPX-XXXXXXXX"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# --- Google Sheets access (service account) ---------------------------------
# Values come from the service account JSON key. The spreadsheet must be shared
# with client_email (Editor).
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "XXXXXXXX"
private_key = "-----BEGIN PRIVATE KEY-----\nXXXXXXXX\n-----END PRIVATE KEY-----\n"
client_email = "your-sa@your-project-id.iam.gserviceaccount.com"
client_id = "000000000000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/your-sa%40your-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
