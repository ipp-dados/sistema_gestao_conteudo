
# Sistema de Gestão de Conteúdo
# Modelo de configuração do ambiente
#
# Copie este arquivo para .streamlit/secrets.toml
# Substitua os valores fictícios pelas credenciais reais.
# Nunca publique o secrets.toml no GitHub.

# Autenticação Streamlit
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "INSIRA_UMA_CHAVE_ALEATORIA_SEGURA"
expose_tokens = "access"

# Autenticação Google OAuth
[auth.google]
client_id = "SEU_CLIENT_ID"
client_secret = "SEU_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
client_kwargs = { scope = "openid email profile https://www.googleapis.com/auth/drive.file" }

# Conta de serviço Google Sheets
# Necessária para a configuração atual no servidor.
# No ambiente local, o código também permite OAuth.

[gcp_service_account]
type = "service_account"
project_id = "SEU_PROJECT_ID"
private_key_id = "SEU_PRIVATE_KEY_ID"
private_key = "SUA_PRIVATE_KEY"
client_email = "SUA_CONTA_DE_SERVICO"
client_id = "SEU_CLIENT_ID_CONTA_SERVICO"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "SUA_URL_CERTIFICADO"
universe_domain = "googleapis.com"
